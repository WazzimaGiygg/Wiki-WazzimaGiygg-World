rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.size() > 0;
    }

    function isValidPage(data) {
      return data.slug is string && data.slug.size() <= 200
        && data.title is string && data.title.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRevision(data) {
      return data.revId is string && data.revId.size() <= 128
        && data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRecentChange(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.author is string && data.author.size() <= 100;
    }

    function isValidTalk(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.topicTitle is string && data.topicTitle.size() <= 250
        && data.content is string && data.content.size() <= 50000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidSettings(data) {
      return data.sitename is string && data.sitename.size() <= 100
        && data.languageCode is string && data.languageCode.size() <= 10;
    }

    // Wiki Pages collection
    match /wiki_pages/{pageId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPage(request.resource.data);
      allow update: if isSignedIn() && isValidPage(request.resource.data);
      allow delete: if isSignedIn();

      // Revisions subcollection (immutable, authenticated only)
      match /revisions/{revId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidRevision(request.resource.data);
        allow update: if false; // Revisions are immutable
        allow delete: if isSignedIn();
      }

      // Talks subcollection (discussion comments, authenticated only)
      match /talks/{talkId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidTalk(request.resource.data);
        allow update: if isSignedIn() && isValidTalk(request.resource.data);
        allow delete: if isSignedIn();
      }
    }

    // Recent changes log (authenticated only)
    match /recent_changes/{changeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidRecentChange(request.resource.data);
      allow update: if false; // Recent change log is append-only
      allow delete: if isSignedIn();
    }

    function isValidExtension(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000;
    }

    // Wiki settings configuration (authenticated only)
    match /wiki_settings/{settingId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidSettings(request.resource.data);
      allow delete: if isSignedIn();
    }

    // User roles / permissions
    match /user_roles/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bureaucrat logs
    match /bureaucrat_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Page protection logs
    match /page_protection_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Wiki extensions (synchronized with codebase & Firestore, managed by bureaucrats)
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidExtension(request.resource.data);
      allow delete: if isSignedIn();
    }

    // CheckUser / Sockpuppet cases
    match /checkuser_cases/{caseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Unblock discussion requests
    match /unblock_requests/{requestId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Arbitration Committee (ArbCom) cases
    match /arbcom_cases/{caseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Universal Code of Conduct (UCoC) reports
    match /ucoc_reports/{reportId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Wiki files and uploaded images (requires signed in)
    match /wiki_files/{fileId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    function isPrivacyOfficerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pedrohenriquecardonaperes@gmail.com'
        || (
          exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.groups.hasAny(['burocrata', 'administrador'])
          )
        )
      );
    }

    function isValidPrivacyRequest(data) {
      return data.keys().hasAll(['requesterUid', 'requesterName', 'type', 'details', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'requesterUid',
          'requesterName',
          'requesterEmail',
          'type',
          'targetUrlOrPage',
          'details',
          'status',
          'responseNote',
          'handledBy',
          'createdAt',
          'updatedAt'
        ])
        && data.requesterUid is string && data.requesterUid.size() > 0 && data.requesterUid.size() <= 128
        && data.requesterName is string && data.requesterName.size() > 0 && data.requesterName.size() <= 100
        && (!('requesterEmail' in data) || (data.requesterEmail is string && data.requesterEmail.size() <= 200))
        && data.type in [
          'lgpd_acesso',
          'lgpd_retificacao',
          'lgpd_anonimizacao_eliminacao',
          'lgpd_portabilidade',
          'lgpd_revogacao_consentimento',
          'marco_civil_art19',
          'marco_civil_art21'
        ]
        && (!('targetUrlOrPage' in data) || (data.targetUrlOrPage is string && data.targetUrlOrPage.size() <= 300))
        && data.details is string && data.details.size() > 0 && data.details.size() <= 4000
        && data.status in ['recebida', 'em_analise', 'atendida', 'indeferida']
        && (!('responseNote' in data) || (data.responseNote is string && data.responseNote.size() <= 2000))
        && (!('handledBy' in data) || (data.handledBy is string && data.handledBy.size() <= 100))
        && data.createdAt is string && data.updatedAt is string;
    }

    // LGPD Art. 18 & Marco Civil Art. 19/21 privacy requests (strict PII isolation)
    match /privacy_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterUid == request.auth.uid
        || isPrivacyOfficerOrAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'recebida'
        && isValidPrivacyRequest(request.resource.data);
      allow update: if isPrivacyOfficerOrAdmin()
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseNote', 'handledBy', 'updatedAt'])
        && isValidPrivacyRequest(request.resource.data);
      allow delete: if false;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['action', 'target', 'details', 'performedBy', 'performedByUid', 'timestamp'])
        && data.keys().hasOnly(['action', 'target', 'details', 'performedBy', 'performedByUid', 'timestamp'])
        && data.action in ['page_delete', 'site_notice_update', 'maintenance_toggle', 'backup_export', 'system_resync', 'settings_update']
        && data.target is string && data.target.size() > 0 && data.target.size() <= 200
        && data.details is string && data.details.size() > 0 && data.details.size() <= 2000
        && data.performedBy is string && data.performedBy.size() > 0 && data.performedBy.size() <= 100
        && data.performedByUid is string && data.performedByUid == request.auth.uid
        && data.timestamp is string;
    }

    // Centralized Firebase admin audit logs (bureaucrat/admin only, append-only)
    match /admin_audit_logs/{logId} {
      allow read: if isPrivacyOfficerOrAdmin();
      allow create: if isPrivacyOfficerOrAdmin() && isValidAdminAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
