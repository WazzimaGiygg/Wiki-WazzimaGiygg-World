rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions — strict non-anonymous authentication & RBAC
    function isSignedIn() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isBureaucrat() {
      return isSignedIn() && (
        (
          request.auth.token.email == 'pedrohenriquecardonaperes@gmail.com'
          && request.auth.token.email_verified == true
        )
        || (
          exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.groups.hasAny(['burocrata'])
        )
      );
    }

    function isAdminOrBureaucrat() {
      return isBureaucrat() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.groups.hasAny(['burocrata', 'administrador'])
      );
    }

    function isNotBlocked() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/user_roles/$(request.auth.uid))
        || !get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.groups.hasAny(['bloqueado'])
      );
    }

    function isMaintenanceMode() {
      return exists(/databases/$(database)/documents/wiki_settings/global)
        && get(/databases/$(database)/documents/wiki_settings/global).data.maintenanceMode == true;
    }

    function isValidPage(data) {
      return data.slug is string && data.slug.size() <= 200
        && data.title is string && data.title.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRevision(data) {
      return data.revId is string && data.revId.size() <= 128
        && data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.content is string && data.content.size() <= 500000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidRecentChange(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.pageTitle is string && data.pageTitle.size() <= 250
        && data.author is string && data.author.size() <= 100;
    }

    function isValidTalk(data) {
      return data.pageId is string && data.pageId.size() <= 200
        && data.topicTitle is string && data.topicTitle.size() <= 250
        && data.content is string && data.content.size() <= 50000
        && data.author is string && data.author.size() <= 100;
    }

    function isValidSettings(data) {
      return (!('sitename' in data) || (data.sitename is string && data.sitename.size() > 0 && data.sitename.size() <= 100))
        && (!('languageCode' in data) || (data.languageCode is string && data.languageCode.size() > 0 && data.languageCode.size() <= 10))
        && (!('allowAnonymousEditing' in data) || data.allowAnonymousEditing == false);
    }

    function isValidExtension(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000;
    }

    // Wiki Pages collection — strictly authenticated, non-blocked users only (bureaucrats bypass maintenance)
    match /wiki_pages/{pageId} {
      allow read: if true;
      allow create, update: if isNotBlocked()
        && isValidPage(request.resource.data)
        && (isBureaucrat() || !isMaintenanceMode());
      allow delete: if isBureaucrat();

      // Revisions subcollection (immutable, authenticated non-blocked only)
      match /revisions/{revId} {
        allow read: if true;
        allow create: if isNotBlocked()
          && isValidRevision(request.resource.data)
          && (isBureaucrat() || !isMaintenanceMode());
        allow update: if false; // Revisions are immutable
        allow delete: if isBureaucrat();
      }

      // Talks subcollection (discussion comments, authenticated non-blocked only)
      match /talks/{talkId} {
        allow read: if true;
        allow create: if isNotBlocked() && isValidTalk(request.resource.data);
        allow update: if isBureaucrat() || (isNotBlocked() && resource.data.authorId == request.auth.uid && isValidTalk(request.resource.data));
        allow delete: if isBureaucrat() || (isNotBlocked() && resource.data.authorId == request.auth.uid);
      }
    }

    // Recent changes log (authenticated non-blocked only, append-only)
    match /recent_changes/{changeId} {
      allow read: if true;
      allow create: if isNotBlocked() && isValidRecentChange(request.resource.data);
      allow update: if false;
      allow delete: if isBureaucrat();
    }

    // Wiki settings configuration — STRICTLY BUREAUCRAT ONLY
    match /wiki_settings/{settingId} {
      allow read: if true;
      allow create, update: if isBureaucrat() && isValidSettings(request.resource.data);
      allow delete: if false;
    }

    // User roles / permissions — STRICTLY BUREAUCRAT ONLY (prevents privilege escalation)
    match /user_roles/{userId} {
      allow read: if true;
      allow create, update, delete: if isBureaucrat();
    }

    // Bureaucrat logs — STRICTLY BUREAUCRAT ONLY, append-only
    match /bureaucrat_logs/{logId} {
      allow read: if true;
      allow create: if isBureaucrat();
      allow update, delete: if false;
    }

    // Page protection logs — ADMIN/BUREAUCRAT ONLY, append-only
    match /page_protection_logs/{logId} {
      allow read: if true;
      allow create: if isAdminOrBureaucrat();
      allow update, delete: if false;
    }

    // Wiki extensions — Bureaucrats manage all; Administrators can configure extension settings (e.g., Blaze Plan on upload-wizard)
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow create: if isValidExtension(request.resource.data) && (
        isBureaucrat()
        || (isAdminOrBureaucrat() && extensionId == 'upload-wizard')
      );
      allow update: if isValidExtension(request.resource.data) && (
        isBureaucrat()
        || (
          isAdminOrBureaucrat()
          && request.resource.data.id == resource.data.id
          && request.resource.data.installedVia == resource.data.installedVia
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['config', 'updatedAt', 'updatedBy'])
        )
      );
      allow delete: if isBureaucrat();
    }

    // CheckUser / Sockpuppet cases — authenticated submit, admin/bureaucrat manage
    match /checkuser_cases/{caseId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrBureaucrat();
    }

    // Unblock discussion requests — authenticated users can submit/comment, bureaucrats decide
    match /unblock_requests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdminOrBureaucrat() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow delete: if isBureaucrat();
    }

    // Arbitration Committee (ArbCom) cases
    match /arbcom_cases/{caseId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrBureaucrat();
    }

    // Universal Code of Conduct (UCoC) reports
    match /ucoc_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdminOrBureaucrat();
    }

    function isValidWikiFile(data) {
      return data.keys().hasAll(['id', 'title', 'fileName', 'url', 'mimeType', 'size', 'uploadedBy', 'uploadedByUid', 'description', 'license', 'timestamp'])
        && data.keys().hasOnly(['id', 'title', 'fileName', 'url', 'mimeType', 'size', 'uploadedBy', 'uploadedByUid', 'description', 'license', 'timestamp', 'width', 'height'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 200
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 200
        && data.url is string && data.url.size() > 0 && data.url.size() <= 950000
        && data.mimeType is string && data.mimeType.size() > 0 && data.mimeType.size() <= 100
        && data.size is number && data.size > 0 && data.size <= 10485760
        && data.uploadedBy is string && data.uploadedBy.size() > 0 && data.uploadedBy.size() <= 100
        && data.uploadedByUid is string && data.uploadedByUid.size() > 0 && data.uploadedByUid.size() <= 128
        && data.description is string && data.description.size() <= 2000
        && data.license is string && data.license.size() <= 100
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64
        && (!('width' in data) || (data.width is number && data.width > 0))
        && (!('height' in data) || (data.height is number && data.height > 0));
    }

    // Wiki files and uploaded images (requires authenticated non-blocked user)
    match /wiki_files/{fileId} {
      allow read: if true;
      allow create: if isNotBlocked()
        && request.resource.data.uploadedByUid == request.auth.uid
        && isValidWikiFile(request.resource.data);
      allow update: if isBureaucrat()
        && request.resource.data.uploadedByUid == resource.data.uploadedByUid
        && isValidWikiFile(request.resource.data);
      allow delete: if isBureaucrat();
    }

    function isValidPrivacyRequest(data) {
      return data.keys().hasAll(['requesterUid', 'requesterName', 'type', 'details', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'requesterUid',
          'requesterName',
          'requesterEmail',
          'type',
          'targetUrlOrPage',
          'details',
          'status',
          'responseNote',
          'handledBy',
          'createdAt',
          'updatedAt'
        ])
        && data.requesterUid is string && data.requesterUid.size() > 0 && data.requesterUid.size() <= 128
        && data.requesterName is string && data.requesterName.size() > 0 && data.requesterName.size() <= 100
        && (!('requesterEmail' in data) || (data.requesterEmail is string && data.requesterEmail.size() <= 200))
        && data.type in [
          'lgpd_acesso',
          'lgpd_retificacao',
          'lgpd_anonimizacao_eliminacao',
          'lgpd_portabilidade',
          'lgpd_revogacao_consentimento',
          'marco_civil_art19',
          'marco_civil_art21'
        ]
        && (!('targetUrlOrPage' in data) || (data.targetUrlOrPage is string && data.targetUrlOrPage.size() <= 300))
        && data.details is string && data.details.size() > 0 && data.details.size() <= 4000
        && data.status in ['recebida', 'em_analise', 'atendida', 'indeferida']
        && (!('responseNote' in data) || (data.responseNote is string && data.responseNote.size() <= 2000))
        && (!('handledBy' in data) || (data.handledBy is string && data.handledBy.size() <= 100))
        && data.createdAt is string && data.updatedAt is string;
    }

    // LGPD Art. 18 & Marco Civil Art. 19/21 privacy requests (strict PII isolation)
    match /privacy_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterUid == request.auth.uid
        || isAdminOrBureaucrat()
      );
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'recebida'
        && isValidPrivacyRequest(request.resource.data);
      allow update: if isAdminOrBureaucrat()
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseNote', 'handledBy', 'updatedAt'])
        && isValidPrivacyRequest(request.resource.data);
      allow delete: if false;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['action', 'target', 'details', 'performedBy', 'performedByUid', 'timestamp'])
        && data.keys().hasOnly(['action', 'target', 'details', 'performedBy', 'performedByUid', 'timestamp'])
        && data.action in ['page_delete', 'site_notice_update', 'maintenance_toggle', 'backup_export', 'system_resync', 'settings_update']
        && data.target is string && data.target.size() > 0 && data.target.size() <= 200
        && data.details is string && data.details.size() > 0 && data.details.size() <= 2000
        && data.performedBy is string && data.performedBy.size() > 0 && data.performedBy.size() <= 100
        && data.performedByUid is string && data.performedByUid == request.auth.uid
        && data.timestamp is string;
    }

    // Centralized Firebase admin audit logs (bureaucrat/admin only, append-only)
    match /admin_audit_logs/{logId} {
      allow read: if isAdminOrBureaucrat();
      allow create: if isAdminOrBureaucrat() && isValidAdminAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    function isValidUserWatchlistId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserWatchlist(data, userId) {
      return data.keys().hasAll(['userId', 'slugs', 'notifyEnabled', 'notifyOwnEdits', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'slugs', 'notifyEnabled', 'notifyOwnEdits', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == userId
        && data.slugs is list && data.slugs.size() <= 200
        && (data.slugs.size() == 0 || (data.slugs[0] is string && data.slugs[0].size() > 0 && data.slugs[0].size() <= 200))
        && data.notifyEnabled is bool
        && data.notifyOwnEdits is bool
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    // Per-user monitored pages watchlist and push notification preferences (strict owner isolation)
    match /user_watchlists/{userId} {
      allow get: if isSignedIn() && isValidUserWatchlistId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidUserWatchlistId(userId)
        && request.auth.uid == userId
        && isValidUserWatchlist(request.resource.data, userId);
      allow update: if isSignedIn()
        && isValidUserWatchlistId(userId)
        && request.auth.uid == userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slugs', 'notifyEnabled', 'notifyOwnEdits', 'updatedAt'])
        && isValidUserWatchlist(request.resource.data, userId);
      allow delete: if isSignedIn() && isValidUserWatchlistId(userId) && request.auth.uid == userId;
    }

    function isValidAdminDiscussionId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAdminDiscussion(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'author', 'authorUid', 'authorRole', 'status', 'replies', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'category', 'content', 'author', 'authorUid', 'authorRole', 'status', 'replies', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 250
        && data.category in ['geral', 'bloqueios', 'seguranca', 'politicas', 'tecnico']
        && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
        && data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && data.authorUid is string && data.authorUid.size() > 0 && data.authorUid.size() <= 128
        && data.authorRole is string && data.authorRole.size() > 0 && data.authorRole.size() <= 50
        && data.status in ['aberto', 'em_votacao', 'resolvido', 'arquivado']
        && data.replies is list && data.replies.size() <= 200
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    // Internal Administrator & Bureaucrat Discussion Area (strictly staff-only)
    match /admin_discussions/{topicId} {
      allow get, list: if isAdminOrBureaucrat();
      allow create: if isAdminOrBureaucrat()
        && isValidAdminDiscussionId(topicId)
        && isValidAdminDiscussion(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdminOrBureaucrat()
        && isValidAdminDiscussionId(topicId)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies', 'status', 'updatedAt'])
        && isValidAdminDiscussion(request.resource.data);
      allow delete: if isBureaucrat() && isValidAdminDiscussionId(topicId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
